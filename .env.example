# Application
APP_NAME=Enterprise Knowledge Copilot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ALLOWED_ORIGINS=[]

# PostgreSQL
POSTGRES_DB=knowledge_copilot
POSTGRES_USER=knowledge_copilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://knowledge_copilot:change-me@postgres:5432/knowledge_copilot
DATABASE_ECHO=false

# Ingestion
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Qdrant derived vector index
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks_multilingual_e5_small_v1
QDRANT_TIMEOUT_SECONDS=30

# Local multilingual embeddings (pinned for reproducibility)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=0e60b8d9d2166d80387f86e3b48ec9ced55f4d15
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIRECTORY=data/model_cache

# LLM providers (generation begins in Phase 4)
LLM_PROVIDER=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=700

# RAG
RAG_MAX_CONTEXT_CHARACTERS=12000
CITATION_EXCERPT_MAX_CHARACTERS=500
DENSE_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=20
RRF_K=60
# Experimental and disabled by default. Scores are mode-specific and not interchangeable.
EVIDENCE_MIN_DENSE_SCORE=
EVIDENCE_MIN_RRF_SCORE=
EVIDENCE_MIN_RERANKER_SCORE=

# Local multilingual reranker (lazy; raw outputs are relevance scores, not probabilities)
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_CACHE_DIRECTORY=data/model_cache
RERANK_CANDIDATE_LIMIT=20
RERANK_FINAL_TOP_K=5

# Deterministic two-version comparison
COMPARISON_CONTENT_SIMILARITY_THRESHOLD=0.6
COMPARISON_SEMANTIC_SIMILARITY_THRESHOLD=0.95
COMPARISON_MAX_SECTIONS=100

# Controlled application agent
AGENT_MAX_TOOL_STEPS=4
AGENT_TIMEOUT_SECONDS=30

# Portable Docker bind mounts. Relative paths resolve beneath the cloned repository.
POSTGRES_DATA_PATH=./data/runtime/postgres
QDRANT_DATA_PATH=./data/runtime/qdrant
DOCKER_UPLOAD_PATH=./data/runtime/uploads
DOCKER_MODEL_CACHE_PATH=./data/model_cache
MIGRATION_MAX_ATTEMPTS=10
MIGRATION_RETRY_SECONDS=2

# Optional on Windows: set to D:\AI_Cache\huggingface to keep shared HF cache data on D:.
HF_HOME=
