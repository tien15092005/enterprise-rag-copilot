# Application
APP_NAME=Enterprise Knowledge Copilot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL
POSTGRES_DB=knowledge_copilot
POSTGRES_USER=knowledge_copilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://knowledge_copilot:change-me@postgres:5432/knowledge_copilot
DATABASE_ECHO=false

# Ingestion
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Qdrant derived vector index
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks_multilingual_e5_small_v1
QDRANT_TIMEOUT_SECONDS=30

# Local multilingual embeddings (pinned for reproducibility)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=0e60b8d9d2166d80387f86e3b48ec9ced55f4d15
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIRECTORY=data/model_cache

# LLM providers (generation begins in Phase 4)
LLM_PROVIDER=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=700

# RAG
RAG_MAX_CONTEXT_CHARACTERS=12000
CITATION_EXCERPT_MAX_CHARACTERS=500

# Optional on Windows: set to D:\AI_Cache\huggingface to keep shared HF cache data on D:.
HF_HOME=
